<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09090B">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#09090B"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="14dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- عنوان بدون پسوند نوردیک -->
                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFFLINEPW"
                    android:textColor="#F4F4F5"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:fontFamily="monospace"
                    android:textSize="15sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <!-- دکمه‌های سمت راست متناسب با UI نوردیک -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <!-- دکمه تغییر زبان -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLanguage"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="44dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:text="FA"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="#F4F4F5"
                        app:backgroundTint="#18181B"
                        app:strokeColor="#27272A"
                        app:strokeWidth="1dp"
                        app:cornerRadius="10dp"
                        android:layout_marginEnd="6dp" />

                    <!-- دکمه دارک/لایت مود -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnThemeToggle"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="40dp"
                        android:layout_height="36dp"
                        android:padding="0dp"
                        android:text="🌙"
                        android:textSize="13sp"
                        android:textColor="#F4F4F5"
                        app:backgroundTint="#18181B"
                        app:strokeColor="#27272A"
                        app:strokeWidth="1dp"
                        app:cornerRadius="10dp" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.appcompat.widget.Toolbar>

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="10dp"
            android:hint="جستجو در عنوان، حساب و تگ‌ها..."
            android:textColorHint="#71717A"
            android:textColor="#F4F4F5"
            android:textSize="13sp"
            android:paddingHorizontal="14dp"
            android:background="@drawable/bg_search_input" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVault"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="90dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:src="@drawable/ic_add"
        app:backgroundTint="#F4F4F5"
        app:tint="#09090B"
        app:elevation="4dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
