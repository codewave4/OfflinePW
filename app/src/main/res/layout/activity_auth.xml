<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#09090B"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:layout_marginBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAuthLang"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="FA"
            android:textColor="#F4F4F5"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="#18181B"
            app:cornerRadius="12dp"
            app:strokeColor="#27272A"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@mipmap/ic_launcher"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvAuthTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OfflinePW"
        android:textColor="#F4F4F5"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvAuthPrompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter your Master Password"
        android:textColor="#A1A1AA"
        android:textSize="15sp"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvAuthWarning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your master password is never stored; therefore, if forgotten, recovery is mathematically impossible."
        android:textColor="#EF4444"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilMasterPassword"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:endIconMode="password_toggle"
        app:endIconTint="#A1A1AA"
        app:boxStrokeColor="#3B82F6"
        app:hintTextColor="#3B82F6"
        android:hint="Master Password">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMasterPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textColor="#F4F4F5"
            android:textSize="16sp"
            android:imeOptions="actionDone" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvLockoutTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:letterSpacing="0.15"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUnlock"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="Unlock"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#09090B"
        app:backgroundTint="#E4E4E7"
        app:cornerRadius="14dp" />

</LinearLayout>
