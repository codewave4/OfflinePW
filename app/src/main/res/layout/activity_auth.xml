<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#09090B"
    android:padding="24dp">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_launcher"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvAuthPrompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="رمز مستر ۶ رقمی را وارد کنید"
        android:textColor="#F4F4F5"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/tvPinIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="○ ○ ○ ○ ○ ○"
        android:textColor="#3B82F6"
        android:textSize="26sp"
        android:letterSpacing="0.2"
        android:layout_marginBottom="32dp" />

    <!-- کیپد عددی -->
    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="true">

        <Button android:id="@+id/btn1" style="@style/Widget.Material3.Button.TonalButton" android:text="1" android:layout_margin="8dp" android:textSize="20sp" android:minWidth="72dp" android:minHeight="72dp"/>
        <Button android:id="@+id/btn2" style="@style/Widget.Material3.Button.TonalButton" android:text="2" android:layout_margin="8dp" android:textSize="20sp" android:minWidth="72dp" android:minHeight="72dp"/>
        <Button android:id="@+id/btn3" style="@style/Widget.Material3.Button.TonalButton" android:text="3" android:layout_margin="8dp" android:textSize="20sp" android:minWidth="72dp" android:minHeight="72dp"/>

        <Button android:id="@+id/btn4" style="@style/Widget.Material3.Button.TonalButton" android:text="4" android:layout_margin="8dp" android:textSize="20sp" android:minWidth="72dp" android:minHeight="72dp"/>
        <Button android:id="@+id/btn5" style="@style/Widget.Material3.Button.TonalButton" android:text="5" android:layout_margin="8dp" android:textSize="20sp" android:minWidth="72dp" android:minHeight="72dp"/>
        <Button android:id="@+id/btn6" style="@style/Widget.Material3.Button.TonalButton" android:text="6" android:layout_margin="8dp" android:textSize="20sp" android:minWidth="72dp" android:minHeight="72dp"/>

        <Button android:id="@+id/btn7" style="@style/Widget.Material3.Button.TonalButton" android:text="7" android:layout_margin="8dp" android:textSize="20sp" android:minWidth="72dp" android:minHeight="72dp"/>
        <Button android:id="@+id/btn8" style="@style/Widget.Material3.Button.TonalButton" android:text="8" android:layout_margin="8dp" android:textSize="20sp" android:minWidth="72dp" android:minHeight="72dp"/>
        <Button android:id="@+id/btn9" style="@style/Widget.Material3.Button.TonalButton" android:text="9" android:layout_margin="8dp" android:textSize="20sp" android:minWidth="72dp" android:minHeight="72dp"/>

        <Space android:layout_width="72dp" android:layout_height="72dp" android:layout_margin="8dp"/>
        <Button android:id="@+id/btn0" style="@style/Widget.Material3.Button.TonalButton" android:text="0" android:layout_margin="8dp" android:textSize="20sp" android:minWidth="72dp" android:minHeight="72dp"/>
        <Button android:id="@+id/btnBackspace" style="@style/Widget.Material3.Button.TextButton" android:text="⌫" android:layout_margin="8dp" android:textSize="22sp" android:textColor="#EF4444" android:minWidth="72dp" android:minHeight="72dp"/>
    </GridLayout>

</LinearLayout>
